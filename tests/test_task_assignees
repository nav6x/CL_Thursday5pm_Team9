def test_list_tasks_task_without_assignees_gets_empty_list(monkeypatch):
    """A task nobody is assigned to should have an empty assignees list."""

    task_rows = [{"id": "task-1", "name": "Unassigned task"}]

    response, status_code, _, _ = call_list_tasks(monkeypatch, task_rows, [])

    assert status_code == 200
    assert response.get_json()[0]["assignees"] == []


def test_list_tasks_attaches_assignee_to_its_task(monkeypatch):
    """An assignee should show up on the task they are assigned to."""

    task_rows = [{"id": "task-1", "name": "Assigned task"}]
    assignee_rows = [
        {
            "task_id": "task-1",
            "profiles": {"id": "user-2", "full_name": "Dan Dev"}
        }
    ]

    response, status_code, _, _ = call_list_tasks(monkeypatch, task_rows, assignee_rows)

    assert status_code == 200
    assert response.get_json()[0]["assignees"] == [
        {"id": "user-2", "full_name": "Dan Dev"}
    ]


def test_list_tasks_task_can_have_multiple_assignees(monkeypatch):
    """Every assignee of a task should be listed, in the order returned."""

    task_rows = [{"id": "task-1", "name": "Shared task"}]
    assignee_rows = [
        {"task_id": "task-1", "profiles": {"id": "user-2", "full_name": "Dan Dev"}},
        {"task_id": "task-1", "profiles": {"id": "user-3", "full_name": "Dee Dev"}},
    ]

    response, _, _, _ = call_list_tasks(monkeypatch, task_rows, assignee_rows)

    assignees = response.get_json()[0]["assignees"]

    assert [a["id"] for a in assignees] == ["user-2", "user-3"]


def test_list_tasks_assignees_only_go_on_their_own_task(monkeypatch):
    """Assignees must not be mixed up between tasks."""

    task_rows = [
        {"id": "task-1", "name": "First task"},
        {"id": "task-2", "name": "Second task"},
        {"id": "task-3", "name": "Third task"},
    ]
    assignee_rows = [
        {"task_id": "task-1", "profiles": {"id": "user-2", "full_name": "Dan Dev"}},
        {"task_id": "task-2", "profiles": {"id": "user-3", "full_name": "Dee Dev"}},
    ]

    response, _, _, _ = call_list_tasks(monkeypatch, task_rows, assignee_rows)

    by_id = {t["id"]: t for t in response.get_json()}

    assert [a["id"] for a in by_id["task-1"]["assignees"]] == ["user-2"]
    assert [a["id"] for a in by_id["task-2"]["assignees"]] == ["user-3"]
    assert by_id["task-3"]["assignees"] == []


def test_list_tasks_same_person_can_be_assigned_to_several_tasks(monkeypatch):
    """One person assigned to two tasks should appear on both."""

    task_rows = [
        {"id": "task-1", "name": "First task"},
        {"id": "task-2", "name": "Second task"},
    ]
    assignee_rows = [
        {"task_id": "task-1", "profiles": {"id": "user-2", "full_name": "Dan Dev"}},
        {"task_id": "task-2", "profiles": {"id": "user-2", "full_name": "Dan Dev"}},
    ]

    response, _, _, _ = call_list_tasks(monkeypatch, task_rows, assignee_rows)

    for task in response.get_json():
        assert [a["id"] for a in task["assignees"]] == ["user-2"]


def test_list_tasks_keeps_original_task_fields(monkeypatch):
    """Adding assignees should not change or drop the task's own fields."""

    task_rows = [
        {
            "id": "task-1",
            "project_id": "project-1",
            "column_id": "column-1",
            "name": "Write report",
            "description": "Draft it",
            "priority": "high",
            "story_points": 5,
            "created_by": "user-1",
        }
    ]

    response, _, _, _ = call_list_tasks(monkeypatch, task_rows, [])

    task = response.get_json()[0]

    assert task["name"] == "Write report"
    assert task["description"] == "Draft it"
    assert task["priority"] == "high"
    assert task["story_points"] == 5
    assert task["created_by"] == "user-1"
    assert task["project_id"] == "project-1"
    assert task["column_id"] == "column-1"